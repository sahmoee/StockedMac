// Secrets.example.xcconfig — Stocked for Mac
// ─────────────────────────────────────────────────────────────────────────────
// TEMPLATE — safe to commit. Copy it next to this file as "Secrets.xcconfig"
// (which is gitignored) and fill in the one real value:
//
//   cp Secrets.example.xcconfig Secrets.xcconfig
//   # then edit Secrets.xcconfig
//
// The Mac app talks to exactly one service — the Stocked Worker — and holds no
// AI vendor keys at all. That is deliberate: anything shipped in an app bundle
// is readable by anyone who downloads it, so all AI work happens server-side.
// ─────────────────────────────────────────────────────────────────────────────

// The shared secret the Worker checks on every household request. Use the same
// value the iOS app uses, or the two won't see the same kitchen.
STOCKED_WORKER_KEY =

// "release" or "debug". Only affects logging verbosity.
STOCKED_ENV = release

// Seconds before a request to the Worker gives up.
NETWORK_TIMEOUT_REQUEST = 12
